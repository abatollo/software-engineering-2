<mxfile host="Electron" compressed="false">
  <diagram id="architecture-system" name="Архитектура системы">
    <mxGraphModel dx="1750" dy="929" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="Архитектура обучающей информационной онлайн-системы ООО «Нондус»" vertex="1">
          <mxGeometry height="40" width="900" x="265" y="20" as="geometry" />
        </mxCell>
        <mxCell id="guest" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Гость" vertex="1">
          <mxGeometry height="90" width="50" x="70" y="132.5" as="geometry" />
        </mxCell>
        <mxCell id="student" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Обучающийся" vertex="1">
          <mxGeometry height="90" width="50" x="70" y="285" as="geometry" />
        </mxCell>
        <mxCell id="staff" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Сотрудники: наставник,&amp;nbsp;&lt;div&gt;куратор,&amp;nbsp;&lt;/div&gt;&lt;div&gt;методист,&amp;nbsp;&lt;/div&gt;&lt;div&gt;специалист сопровождения,&amp;nbsp;&lt;/div&gt;&lt;div&gt;руководитель программы&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="50" x="70" y="442.5" as="geometry" />
        </mxCell>
        <mxCell id="frontend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;spacing=8;perimeterSpacing=1;" value="Пользовательский веб-интерфейс&amp;nbsp;&lt;div&gt;• открытые страницы курсов&amp;nbsp;&lt;/div&gt;&lt;div&gt;• личный кабинет&amp;nbsp;&lt;/div&gt;&lt;div&gt;• кабинеты сотрудников&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="220" x="230" y="125" as="geometry" />
        </mxCell>
        <mxCell id="auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;spacing=8;perimeterSpacing=1;" value="Модуль регистрации, авторизации и ролей&amp;nbsp;&lt;div&gt;• учетные записи&amp;nbsp;&lt;/div&gt;&lt;div&gt;• персональные данные&amp;nbsp;&lt;/div&gt;&lt;div&gt;• разграничение доступа&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="280" x="190" y="290" as="geometry" />
        </mxCell>
        <mxCell id="courses" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;spacing=8;perimeterSpacing=1;" value="Модуль управления курсами и материалами&amp;nbsp;&lt;div&gt;• курсы, модули, уроки&amp;nbsp;&lt;/div&gt;&lt;div&gt;• тексты, файлы, видео&amp;nbsp;&lt;/div&gt;&lt;div&gt;• открытые и закрытые материалы&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="290" x="510" y="117.5" as="geometry" />
        </mxCell>
        <mxCell id="learning" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;spacing=8;perimeterSpacing=1;" value="Модуль обучения и прогресса&amp;nbsp;&lt;div&gt;• запись на курс&amp;nbsp;&lt;/div&gt;&lt;div&gt;• прохождение модулей&amp;nbsp;&lt;/div&gt;&lt;div&gt;• статусы и контрольные точки&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="230" x="600" y="417.5" as="geometry" />
        </mxCell>
        <mxCell id="sandbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;spacing=8;perimeterSpacing=1;" value="Модуль практических заданий и песочниц&amp;nbsp;&lt;div&gt;• задания по веб-разработке&amp;nbsp;&lt;/div&gt;&lt;div&gt;• выполнение кода в браузере&amp;nbsp;&lt;/div&gt;&lt;div&gt;• отправка работ на проверку&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="260" x="1010" y="115" as="geometry" />
        </mxCell>
        <mxCell id="support" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;spacing=8;perimeterSpacing=1;" value="Модуль сопровождения и обратной связи&amp;nbsp;&lt;div&gt;• кураторы и наставники&amp;nbsp;&lt;/div&gt;&lt;div&gt;• комментарии к работам&amp;nbsp;&lt;/div&gt;&lt;div&gt;• обращения и помощь студентам&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="270" x="1010" y="412.5" as="geometry" />
        </mxCell>
        <mxCell id="payment" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;spacing=8;perimeterSpacing=1;" value="Модуль заявок и оплаты&amp;nbsp;&lt;div&gt;• заявка на обучение&amp;nbsp;&lt;/div&gt;&lt;div&gt;• статус оплаты&amp;nbsp;&lt;/div&gt;&lt;div&gt;• доступ к платным материалам&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="240" x="210" y="420" as="geometry" />
        </mxCell>
        <mxCell id="docs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;spacing=8;perimeterSpacing=1;" value="Модуль выпускников и итоговых документов&amp;nbsp;&lt;div&gt;• сертификаты и дипломы&amp;nbsp;&lt;/div&gt;&lt;div&gt;• публичная проверка по URL&amp;nbsp;&lt;/div&gt;&lt;div&gt;• карьерные рекомендации&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="280" x="120" y="655" as="geometry" />
